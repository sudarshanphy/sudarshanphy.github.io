/* ============================================
   GLOBAL BACKGROUND
   ============================================ */

body {
  background: url('/images/blender_3dsph_d9.6_chk_1069.png')
              no-repeat center center fixed;
  background-size: cover;
  color: #f2f2f2;
  font-size: 20px;
  min-height: 100vh;
}

html {
  min-height: 100%;
  overflow-y: auto;
}

/* ============================================
   TEXT COLORS
   ============================================ */

h1, h2, h3, h4, h5, h6 {
  color: #ffffff !important;
}

a {
  color: #ffd65a !important;
}
a:hover {
  color: #ffae00 !important;
}


/* ============================================
   GLASS OVERLAY FOR PAGE CONTENT
   Applies to: About, Research, CV, posts, etc.
   ============================================ */

.page,
.wrapper,
.page__content,
.archive,
.page__hero {
  background: rgba(0, 0, 0, 0.45);    /* transparent layer */
  backdrop-filter: blur(10px);        /* GLASS EFFECT */
  -webkit-backdrop-filter: blur(10px);
  padding: 2rem;
  border-radius: 16px;
  min-height: 50vh;
  height: auto !important;
  box-shadow: 0 0 30px rgba(0,0,0,0.3);
}

/* Ensures child content doesn’t remove the blur */
.page__content > * {
  background: transparent !important;
}


/* ============================================
   SIDEBAR GLASS PANEL
   ============================================ */

.sidebar,
.sidebar__inner,
.author__content {
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  max-height: 100vh;
  overflow-y: auto !important;
  padding: 1rem;
  border-radius: 12px;
  box-shadow: 0 0 20px rgba(0,0,0,0.4);
}


/* ============================================
   DECORATIVE EXTRAS
   ============================================ */

img {
  border-radius: 8px;
}

hr {
  border-color: #888;
  opacity: 0.6;
}
/* ============================================
   FORCE NAVBAR TEXT COLORS — CORRECTED SELECTORS
   ============================================ */

/* DARK THEME: navbar text should be WHITE */
:root[data-theme="dark"] #site-nav a,
:root[data-theme="dark"] #site-nav .masthead__menu-item a,
:root[data-theme="dark"] #site-nav .navicon,
:root[data-theme="dark"] #site-nav i {
  color: #ffffff !important;
}

/* LIGHT THEME: navbar text should be DARK */
:root[data-theme="light"] #site-nav a,
:root[data-theme="light"] #site-nav .masthead__menu-item a,
:root[data-theme="light"] #site-nav .navicon,
:root[data-theme="light"] #site-nav i {
  color: #222222 !important;
}


/* ============================================
   PAGE CONTENT LINKS (yellow only in content)
   ============================================ */

.page__content a,
.page a,
.archive a {
  color: #ffd65a !important;
}

.page__content a:hover,
.page a:hover,
.archive a:hover {
  color: #ffae00 !important;
}

/* Do NOT color the navbar or sidebar links yellow */
#site-nav a,
.sidebar a {
  color: inherit !important;
}

/* ==============================================
   FORCE DARK THEME — disable light mode entirely
   ============================================== */

:root {
  color-scheme: dark !important;
}

:root[data-theme="light"] {
  color-scheme: dark !important;
  background: transparent !important;
  filter: none !important;
}

/* Remove theme toggle button */
#theme-toggle {
  display: none !important;
}

/* Stop the sidebar from stretching the full height */
.sidebar,
.sidebar__inner,
.author__content {
  min-height: auto !important;
  height: auto !important;
}

/* Lighter glass background ONLY for sidebar content */
.sidebar__inner {
  background: rgba(0, 0, 0, 0.25) !important;  /* adjust opacity */
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 12px;
  padding: 1rem;
}

/* Always force dark theme styling */
:root[data-theme="light"] {
  background: transparent !important;
  color: #f2f2f2 !important;
}

/* Fix navbar in case theme switches before JS override */
:root[data-theme="light"] #site-nav a,
:root[data-theme="light"] #site-nav i {
  color: #f2f2f2 !important;
}

#counter {
  background: rgba(0,0,0,0.35);
  padding: 0.4rem 0.8rem;
  border-radius: 10px;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  display: inline-block;
}


/* Project Grid */
.project-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 2rem;
  margin-top: 2rem;
}

/* Project Card */
.project-card {
  background: rgba(0, 0, 0, 0.55);
  border-radius: 12px;
  padding: 1.2rem;
  transition: background 0.2s ease, transform 0.2s ease;
}

.project-card:hover {
  background: rgba(0, 0, 0, 0.70);
  transform: translateY(-4px);
}

/* Thumbnail */
.project-image {
  width: 100%;
  height: 160px;
  object-fit: cover;
  border-radius: 8px;
  margin-bottom: 1rem;
  box-shadow: 0 0 10px rgba(0,0,0,0.4);
}

/* Title */
.project-title a {
  color: #ffd65a;
}

.project-title a:hover {
  color: #ffae00;
  text-decoration: underline;
}

/* Description */
.project-description {
  color: #e8e8e8;
  font-size: 0.95rem;
  margin-top: 0.5rem;
}

.img-small {
  width: 40%;
  display: block;
  margin: 10px auto;
}

.img-medium {
  width: 60%;
  display: block;
  margin: 10px auto;
}

/* -------------------------------------------------------
   GLOBAL BODY + BACKGROUND
--------------------------------------------------------- */

body {
  background: url('/images/blender_3dsph_d9.6_chk_1069.png') no-repeat center center fixed;
  background-size: cover;
  color: #f2f2f2;
  font-size: 20px;
  margin: 0;
  padding: 0;
}

/* Links */
a {
  color: #ffd65a;
}
a:hover {
  color: #ffae00;
}

/* -------------------------------------------------------
   FIXED TOP NAVIGATION BAR (SOLID + DARK)
--------------------------------------------------------- */

.masthead {
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 9999;
  background: #1a1a1a !important;   /* dark solid bar */
  border-bottom: 1px solid #333;
}

/* Add spacing so content is not hidden under masthead */
.page__content,
.archive {
  margin-top: 90px !important;
}


/* -------------------------------------------------------
   SIDEBAR (PROFILE NAVIGATION) – SCROLLABLE AGAIN
--------------------------------------------------------- */

.sidebar {
  position: fixed;
  top: 90px;          /* positioned just under the masthead */
  bottom: 0;
  overflow-y: auto;
  padding-bottom: 2rem;
}

/* For mobile screens, restore original behavior */
@media (max-width: 768px) {
  .sidebar {
    position: static;
    overflow: visible;
    padding-bottom: 0;
  }
}


/* -------------------------------------------------------
   CONTENT AREA (GLASS BOX)
--------------------------------------------------------- */

.page__content {
  background: rgba(0,0,0,0.55);
  padding: 2rem;
  border-radius: 12px;
  min-height: calc(100vh - 140px);  /* adjusts for masthead */
}

/* Remove unwanted backgrounds if inherited */
.page, .wrapper {
  background: transparent !important;
}


/* -------------------------------------------------------
   PROJECT PAGE IMAGES – MAKE SMALLER BY DEFAULT
--------------------------------------------------------- */

.project-page img {
  max-width: 55%;
  display: block;
  margin: 1.5rem auto;
  border-radius: 10px;
}


/* -------------------------------------------------------
   PROJECT GRID & CARDS (from Projects page)
--------------------------------------------------------- */

.project-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 2rem;
  margin-top: 2rem;
}

.project-card {
  background: rgba(0, 0, 0, 0.55);
  border-radius: 12px;
  padding: 1.2rem;
  transition: background 0.2s ease, transform 0.2s ease;
}

.project-card:hover {
  background: rgba(0, 0, 0, 0.70);
  transform: translateY(-4px);
}

.project-image {
  width: 100%;
  height: 160px;
  object-fit: cover;
  border-radius: 8px;
  margin-bottom: 1rem;
  box-shadow: 0 0 10px rgba(0,0,0,0.4);
}

.project-title a {
  color: #ffd65a;
}
.project-title a:hover {
  color: #ffae00;
  text-decoration: underline;
}


/* -------------------------------------------------------
   OPTIONAL SMALL IMAGE UTILITY CLASSES
--------------------------------------------------------- */

.project-img-small {
  width: 40% !important;
  display: block;
  margin: 1rem auto;
  border-radius: 10px;
}

.project-img-medium {
  width: 60% !important;
  display: block;
  margin: 1rem auto;
  border-radius: 10px;
}

